# Optional: short-lived TURN credentials served by your own backend.
# Do not put a long-lived TURN password or Cloudflare API token in VITE_*.
# Credentials endpoint returns { "username": "...", "credential": "..." }.
# Without these settings, bandwidth/latency tests work but AIM stars remain unavailable.
VITE_SPEEDTEST_TURN_URI=turn.example.com:3478
VITE_SPEEDTEST_TURN_CREDENTIALS_URL=https://your-backend.example.com/turn-credentials
